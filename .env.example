# TradeX Solana Program Environment Variables
# Copy this to .env and fill in your values

# ── Program ID ───────────────────────────────────────────────────────────────
# The deployed program address (set by deploy-fresh.sh or manually after deploy)
# Mainnet: TRDXCHHWWZdQXxkGFJxek1KU2hn19687xztNBy99Ca1
PROGRAM_ID=

# ── Network ──────────────────────────────────────────────────────────────────
# Solana RPC endpoint
# Mainnet: Use a private RPC like Helius or QuickNode
SOLANA_RPC_URL=

# ── USDC Mint ────────────────────────────────────────────────────────────────
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ── Keypair ──────────────────────────────────────────────────────────────────
# Path to the admin/authority keypair (relative to project root)
KEYPAIR_PATH=./keypair.json
